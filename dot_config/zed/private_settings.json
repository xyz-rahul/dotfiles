// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "ssh_connections": [
    {
      "host": "e2e",
      "args": [],
      "projects": [
        {
          "paths": [
            "/root/rahul"
          ]
        }
      ]
    },
    {
      "host": "e2e",
      "args": [],
      "projects": []
    }
  ],
  "cli_default_open_behavior": "new_window",
  "linked_edits": true,
  "enable_language_server": true,
  "relative_line_numbers": true,
  "vertical_scroll_margin": 16,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  }
}
