// Zed keymap — ported from ~/.ideavimrc + ~/.vimrc (leader = space)
[
  // Normal + visual mode (VimControl)
  {
    "context": "VimControl && !menu",
    "bindings": {
      // --- Code navigation (was: GotoDeclaration / GotoImplementation / FindUsages / QuickImplementations) ---
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences",
      "g shift-d": "editor::GoToImplementationSplit",

      // --- Diagnostics (was: GotoNextError / GotoPreviousError / ShowErrorDescription) ---
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "space e": "editor::Hover",

      // --- Refactoring / fixes (was: RenameElement / ShowIntentionActions / Spotless format) ---
      "space r n": "editor::Rename",
      "space shift-f": "editor::ToggleCodeActions",
      "space space r": "editor::ToggleCodeActions",
      "space f m": "editor::Format",

      // --- Reveal current file in project panel (was: SelectInProjectView) ---
      "ctrl-e": "pane::RevealInProjectPanel",

      // --- Clipboard yank (was: <leader>y EditorCopy) ---
      "space y": "editor::Copy",

      // --- Close current buffer (was: <leader>x :bd) ---
      "space x": "pane::CloseActiveItem"
    }
  },

  // Normal mode only — centered scrolling and search (nzz / Nzz / <C-d>zz / <C-u>zz)
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z"],
      "shift-n": ["workspace::SendKeystrokes", "shift-n z z"]
    }
  },

  // Visual mode — move lines, keep selection on indent, black-hole delete/paste
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      ">": "editor::Indent",
      "<": "editor::Outdent",
      "space p": ["workspace::SendKeystrokes", "\" _ d shift-p"],
      "space d": ["workspace::SendKeystrokes", "\" _ d"]
    }
  },

  // Insert mode — readline-style line start/end (was: imap <C-a>/<C-e>)
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-a": "editor::MoveToBeginningOfLine",
      "ctrl-e": "editor::MoveToEndOfLine"
    }
  }
]
